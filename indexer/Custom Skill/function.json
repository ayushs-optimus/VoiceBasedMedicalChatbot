{
  "bindings": [
    {
      "authLevel": "function",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": ["post"]
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    },
    {
      "name": "myblob",
      "type": "blobTrigger",
      "direction": "in",
      "path": "medical-xml-data/{name}",
      "connection": "AzureWebJobsStorage"
    },
    {
      "name": "outputBlob",
      "type": "blob",
      "direction": "out",
      "path": "outputfiles/{name}",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
